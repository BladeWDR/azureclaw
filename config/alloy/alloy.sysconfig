# /etc/sysconfig/alloy
# Runtime flags and environment variables for Grafana Alloy on Azureclaw

# Expose Alloy UI and metrics scraper on LAN (port 12345)
CUSTOM_ARGS="--server.http.listen-addr=0.0.0.0:12345 --storage.path=/var/lib/alloy"

# Default fallback URLs (can be populated by Ansible or cloud-init)
PROMETHEUS_REMOTE_WRITE_URL="http://127.0.0.1:9090/api/v1/write"
LOKI_PUSH_URL="http://127.0.0.1:3100/loki/api/v1/push"
PROMETHEUS_USERNAME=""
PROMETHEUS_PASSWORD=""
LOKI_USERNAME=""
LOKI_PASSWORD=""
