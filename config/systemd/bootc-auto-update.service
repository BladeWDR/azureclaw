[Unit]
Description=Azureclaw Automatic Bootc Upgrade and Stage
Documentation=man:bootc(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Checks the registry for a new container version.
# If a new version exists, bootc stages it and automatically triggers a clean reboot.
# If no update exists, it exits cleanly (0) and leaves the system running.
ExecStart=/usr/bin/bootc upgrade --apply

# Allow up to 30 minutes for slow layer downloads
TimeoutSec=1800

StandardOutput=journal
StandardError=journal
